install_symlink {
    name: "symlink_firmware_toco_venus.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/venus.mbn",
    symlink_target: "/vendor/firmware_mnt/image/venus.mdt",
