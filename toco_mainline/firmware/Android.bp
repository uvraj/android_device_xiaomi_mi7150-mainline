}

install_symlink {
    name: "symlink_firmware_toco_modemr.jsn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/modemr.jsn",
    symlink_target: "/vendor/firmware_mnt/image/modemr.jsn",
}

install_symlink {
    name: "symlink_firmware_toco_modemuw.jsn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/modemuw.jsn",
    symlink_target: "/vendor/firmware_mnt/image/modemuw.jsn",
}

install_symlink {
    name: "symlink_firmware_toco_wlanmdsp.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/wlanmdsp.mbn",
    symlink_target: "/vendor/firmware_mnt/image/wlanmdsp.mbn",
}

install_symlink {
    name: "symlink_firmware_toco_adsp.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/adsp.mbn",
    symlink_target: "/vendor/firmware_mnt/image/adsp.mdt",
}

install_symlink {
    name: "symlink_firmware_toco_cdsp.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/cdsp.mbn",
    symlink_target: "/vendor/firmware_mnt/image/cdsp.mdt",
