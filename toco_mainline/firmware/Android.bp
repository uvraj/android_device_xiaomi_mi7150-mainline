install_symlink {
    name: "symlink_firmware_toco_modem.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/modem.mbn",
    symlink_target: "/vendor/firmware_mnt/image/modem.mdt",
