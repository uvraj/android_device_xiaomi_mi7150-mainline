install_symlink {
    name: "symlink_firmware_toco",
    vendor: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco",
    symlink_target: "/odm/firmware/qcom/sm7150/xiaomi/toco",
}

install_symlink {
    name: "symlink_firmware_toco_modem_pr",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/modem_pr",
    symlink_target: "/vendor/firmware_mnt/image/modem_pr",
}

install_symlink {
    name: "symlink_firmware_toco_adspr.jsn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/adspr.jsn",
    symlink_target: "/vendor/firmware_mnt/image/adspr.jsn",
}

install_symlink {
    name: "symlink_firmware_toco_adsps.jsn",
