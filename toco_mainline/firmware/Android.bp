// Workaround soong installing device_specific prebuilt_firmware module to /odm/etc/firmware
install_symlink {
    name: "symlink_firmware_toco_ipa_fws.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/sm7150/xiaomi/toco/ipa_fws.mbn",
    symlink_target: "/odm/etc/firmware/qcom/sm7150/xiaomi/toco/ipa_fws.mbn",
}

phony {
    name: "all_symlink_firmware_toco",
    required: [
        "symlink_firmware_toco",
        "symlink_firmware_toco_adsp.mbn",
        "symlink_firmware_toco_adspr.jsn",
        "symlink_firmware_toco_adsps.jsn",
        "symlink_firmware_toco_adspua.jsn",
        "symlink_firmware_toco_cdsp.mbn",
        "symlink_firmware_toco_cdspr.jsn",
        "symlink_firmware_toco_ipa_fws.mbn",
        "symlink_firmware_toco_modem.mbn",
        "symlink_firmware_toco_modem_pr",
        "symlink_firmware_toco_modemr.jsn",
        "symlink_firmware_toco_modemuw.jsn",
        "symlink_firmware_toco_venus.mbn",
        "symlink_firmware_toco_wlanmdsp.mbn",
    ],
}
